#include <stdio.h>
#include<string.h>
#include<stdlib.h>
int main() {
    char *s="()";
    //stack
    char stack[6];
    int top=-1;
    int l=strlen(s)-1;
    for(int i=0;i<=l;i++){
        if(s[i] == '(' || s[i] == '{' || s[i] == '['){
            top++;
            stack[top]=s[i];
        }
        else if(s[i] == ')' || s[i] == ']' || s[i] == '}'){
            if(top==-1){
                printf("invalid");
                exit(0);
            }
            if(stack[top]=='(' && s[i]==')' || stack[top]=='{' && s[i]=='}' || stack[top]=='[' && s[i]==']'){
                top--;
            }
            else{
                printf("invalid");
                exit(0);
            }
        }
    }
    if(top==-1){
        printf("valid");
    }
    else{
        printf("invalid\n");
    }

    return 0;
}

